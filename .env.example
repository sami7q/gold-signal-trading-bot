APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/goldbot

TRADING_MODE=SIMULATION
AUTO_TRADING=false

PAPER_STARTING_BALANCE=10000
PAPER_SYMBOL=XAUUSD
PAPER_POINT=0.01
PAPER_DIGITS=2
PAPER_CONTRACT_SIZE=100
PAPER_VOLUME_MIN=0.01
PAPER_VOLUME_MAX=50
PAPER_VOLUME_STEP=0.01
PAPER_SPREAD_POINTS=20

SIGNAL_COMPLETION_TIMEOUT_SECONDS=120

TELEGRAM_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=
TELEGRAM_ALLOWED_CHANNEL_ID=
# Real Telegram messages still parse and reach the signal state machine, but
# never reach the trading engine while this is true. Keep true for the first
# real run against a channel; only set false after its message grammar has
# been observed and confirmed. See docs/09-telegram-integration.md.
TELEGRAM_OBSERVE_ONLY=true
TELEGRAM_HEALTH_POLL_SECONDS=15

MT5_ENABLED=false
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=
# Only needed when more than one MT5 terminal is installed -- point it at the
# terminal64.exe of the broker this process should connect to.
MT5_TERMINAL_PATH=
MT5_SYMBOL=XAUUSD
# How far the actual fill may drift from the price the bot quoted a moment
# earlier before the broker refuses the order (MT5's `deviation`, in pips
# here -- 10 pips is $1.00 on a 2-digit-Gold broker). 0 tolerates nothing,
# which is MT5's own default and turns a fast market into a FAILED trade.
MT5_MAX_SLIPPAGE_PIPS=10
# Fernet key encrypting every MT5Account row's MT5 password at rest
# (app/core/credentials.py). Generate once per deployment, never commit it, and
# never swap it out with account rows already saved -- they become undecryptable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ACCOUNT_CREDENTIALS_ENCRYPTION_KEY=
# How often (seconds) every OPEN trade is re-checked against the broker so a
# real SL/TP closure (which happens on MT5's own server, not in this process)
# is detected promptly instead of only at the next restart.
POSITION_POLL_SECONDS=20

DASHBOARD_CORS_ORIGINS=http://localhost:3000

# /docs, /redoc, /openapi.json. Keep true for local dev; set false once deployed.
API_DOCS_ENABLED=true

# Dashboard (Next.js) reads this at build/runtime
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
