# loco-copy settings (botup.md §9). Copy to .env and edit. NO API KEYS HERE -- use `loco-copy set-key`.
# Safe defaults: nothing is traded until COPY_ENABLED=true AND COPY_OBSERVE_ONLY=false.

LEADER_ADDRESS=0xf97ad6704baec104d00b88e0c157e2b7b3a1ddd1
COPY_ENABLED=false
COPY_OBSERVE_ONLY=true
BROKER=paper                     # paper | bybit
BROKER_ENV=demo                  # demo | live  (live also needs LIVE_CONFIRM below)
LIVE_CONFIRM=                    # must equal "I ACCEPT REAL MONEY RISK" for live
RISK_PER_TRADE=0.10
LEVERAGE=20
TAKE_PROFIT_ROI=0.50
PROTECTIVE_SL_PCT=               # not implemented yet -- must stay empty
FOLLOW_ADDS=false                # adds are ignored (owner decision) -- READ README "Strategy finding"
FOLLOW_REDUCES=true
MAX_OPEN_POSITIONS=10
MAX_NOTIONAL_PER_COIN=           # deferred (empty = no cap)
MAX_ENTRY_DRIFT=0.01
MAX_SIGNAL_AGE_MS=10000
MAX_ORDER_SLIPPAGE=0.005
ALLOW_LONG=true
ALLOW_SHORT=true
COIN_ALLOWLIST=                  # comma-separated, empty = all
COIN_BLOCKLIST=
DAILY_LOSS_LIMIT_PCT=0.15
LEADER_DD_BREAKER_PCT=0.20
LEADER_SNAPSHOT_SECONDS=20
RECONCILE_SECONDS=30
MISSED_EXIT_SECONDS=60
STALE_FEED_SECONDS=60
PAPER_START_EQUITY=10000
PAPER_FEE_RATE=0.00055
PAPER_SLIPPAGE_BPS=2
ALERT_TELEGRAM_TOKEN=            # optional, outbound alerts only, separate send-only bot
ALERT_TELEGRAM_CHAT_ID=
